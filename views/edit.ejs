<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h3>Edit Your Chat: <%= chat._id %></h3>
    <p>This chat was sent from <b> <%= chat.from %> </b> to <b> <%= chat.to %> </b></p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">

        <label for="newmsg">Message:</label><br>
        <textarea id="newmsg" name="newmsg" rows="4" cols="30" required><%= chat.msg %></textarea><br><br>

        <button type="submit">Edit</button>
    </form>
</body>
</html>
